# Local development only. Configure production values in the Render dashboard.
DbProvider=PostgreSQL
ConnectionStrings__DbConnection=Host=localhost;Port=5432;Database=pms;Username=postgres;Password=change-me

# Comma-separated browser origins. Leave empty in production until the frontend is deployed.
Cors__AllowedOrigins=http://localhost:5173

RateLimiting__Global__PermitLimit=100
RateLimiting__Global__WindowInSeconds=60
RateLimiting__Authentication__PermitLimit=10
RateLimiting__Authentication__WindowInSeconds=60
RateLimiting__Authentication__SegmentsPerWindow=6
RateLimiting__Export__ConcurrencyLimit=3
RateLimiting__Export__PermitLimit=10
RateLimiting__Export__WindowInSeconds=60
